{
  "name": "note-framework",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "framework:new": "bun scripts/starter.ts",
    "check": "tsc --noEmit",
    "test": "bun test --conditions=browser",
    "dev": "vite",
    "build": "bun run framework:release && vite build",
    "preview": "vite preview",
    "note:new": "bun scripts/note.ts new",
    "note:list": "bun scripts/note.ts list",
    "note:build": "bun scripts/note.ts build",
    "note:publish": "bun scripts/note.ts publish",
    "note:html": "bun scripts/note.ts html",
    "framework:release": "bun scripts/framework-release.ts",
    "share": "bun scripts/share.ts",
    "note:share": "bun scripts/share.ts note",
    "share:build": "bun run framework:release && bun run note:build framework",
    "share:deploy": "bun scripts/sharing-deploy.ts",
    "note:audit": "bun scripts/note.ts audit",
    "visual:check": "bun scripts/audit.ts",
    "visual:install": "bunx playwright install chromium",
    "dev:framework": "VITE_FRAMEWORK_PREVIEW=1 vite",
    "build:framework-preview": "VITE_FRAMEWORK_PREVIEW=1 vite build --outDir dist-framework-preview",
    "check:framework-preview": "bun scripts/framework-preview-check.ts",
    "test:components": "playwright test",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "fmt": "oxfmt src scripts sharing visual component-tests tools *.ts *.json",
    "fmt:check": "oxfmt --check src scripts sharing visual component-tests tools *.ts *.json",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved --no-config-hints",
    "check:all": "bun run lint && bun run fmt:check && bun run deadcode && bun run check && bun run test",
    "test:components:vitest": "vitest run --config vitest.components.config.ts",
    "test:visual": "vitest run --config vitest.components.config.ts component-tests/visual.browser.tsx",
    "test:visual:update": "bun run test:visual --update",
    "public:build": "bun scripts/public-release.ts",
    "public:dev": "wrangler dev --config wrangler.public.jsonc --port 3160 --var PUBLIC_ORIGIN:http://localhost:3160",
    "public:deploy": "bun scripts/public-deploy.ts",
    "framework:export": "bun scripts/public-repository.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@solidjs/router": "^1.0.0",
    "katex": "^0.19.0",
    "motion": "^14.2.0",
    "solid-js": "^1.9.17",
    "svg-pathdata": "9.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@pierre/diffs": "1.6.1",
    "@playwright/test": "1.56.1",
    "@types/bun": "^1.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.5",
    "wrangler": "^4.151.0"
  }
}
