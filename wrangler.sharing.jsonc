{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-framework-share",
  "main": "sharing/worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-framework",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "note-framework-share",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "sharing/migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://note-framework-share.pronsh.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
