{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/index.tsx!",
    "src/framework-preview.tsx!",
    "src/single.tsx!",
    "src/kit/index.ts!",
    "src/notes/*/index.tsx!",
    "scripts/*.{ts,mjs}!",
    "visual/*.{fixture.tsx,visual.ts}!",
    "studies/*/{build,verify,browser-check,preview}.mjs!",
    "studies/*/model.test.js!",
    "src/notes/spring-workshop/verification/*.mjs!",
    "tools/oxlint/index.ts!",
    "src/kit/patterns/recipes.tsx!",
    "studies/ink/scene.js!",
    "studies/mechanical-arm/app.js!",
    "component-tests/**/*.browser.tsx!",
  ],
  "project": [
    "src/**/*.{ts,tsx,js,mjs}",
    "scripts/**/*.{ts,mjs}",
    "sharing/**/*.ts",
    "visual/**/*.{ts,tsx}",
    "tools/**/*.ts",
    "studies/**/*.{ts,js,mjs}",
    "*.ts",
    "component-tests/**/*.{ts,tsx}",
  ],
  "ignore": [
    "src/notes/spring-workshop/vendor/**",
    "src/notes/spring-workshop/verification/vendor/**",
  ],
  "ignoreUnresolved": ["^virtual:", ".*\\?(code|diff)$"],
  "rules": {
    "types": "off",
    "nsTypes": "off",
  },
  "paths": {
    "/src/*": ["./src/*"],
    "/visual/*": ["./visual/*"],
  },
  "ignoreDependencies": ["wrangler"],
}
